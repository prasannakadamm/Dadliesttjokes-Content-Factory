# ==============================================================================
# Dadliesttjokes Content Factory - Environment Configuration Baseline
# Phase 03 Template - Safe placeholders ONLY. Do NOT commit real secrets.
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Web Application (apps/web)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# API Gateway (apps/api)
API_PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database Foundation (Phase 03 - PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dadliesttjokes_dev

# Authentication & Session Foundation (Phase 03)
# AUTH_SECRET must be at least 16 characters long. In production, use a high-entropy secret.
AUTH_SECRET=dev_insecure_auth_secret_must_change_in_production
SESSION_TTL_HOURS=168


# OpenShorts Provider Configuration (Phase 05)
# OPENSHORTS_API_KEY=
# OPENSHORTS_WEBHOOK_SECRET=
# OPENSHORTS_API_URL=https://api.openshorts.app